<div class="timeline-controls" role="group" aria-label="Какие события показывать">
  <button type="button" class="timeline-chip" data-timeline-filter="family" aria-pressed="true">
    <i class="key-dot family" aria-hidden="true"></i>Семейные даты
  </button>
  <button type="button" class="timeline-chip" data-timeline-filter="history" aria-pressed="true">
    <i class="key-dot history" aria-hidden="true"></i>Исторический контекст
  </button>
</div>
<div class="timeline" id="timeline-list" aria-live="polite"></div>
