<!-- Просмотрщик материалов: публичные и приватные медиа (DRIVE-байты → Object URL). -->
<dialog class="media-viewer" id="media-viewer" aria-labelledby="media-viewer-caption">
  <div class="media-viewer-inner">
    <button class="icon-button media-viewer-close" type="button" data-close-dialog aria-label="Закрыть материал">×</button>
    <div class="media-loading" id="media-viewer-loading" hidden>Загрузка семейного материала…</div>
    <div class="media-error" id="media-viewer-error" hidden></div>
    <img id="media-viewer-image" alt="" hidden>
    <a class="media-open-external" id="media-viewer-document" hidden></a>
    <p id="media-viewer-caption"></p>
  </div>
</dialog>
