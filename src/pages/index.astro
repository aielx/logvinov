---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/features/landing.css";
import { pageUrl } from "../lib/urls";
import { canonicalUrlOf, webPageNode, sectionsItemListNode, faqNode, type FaqEntry } from "../lib/seo";

const site = Astro.site ?? new URL("https://logvinov-tree.ru");
const canonical = canonicalUrlOf(Astro.url.pathname, site);

const pageTitle = "Род Логвиновых — семейный архив и генеалогическое древо";
const pageDescription =
  "Семейный генеалогический архив рода Логвиновых: интерактивное древо семьи, хронология поколений и галерея фотографий. Родословная Логвиновых — для родственников и всех, кто ищет свою ветвь рода.";

// FAQ: один источник текста для видимого блока на странице и для FAQPage (JSON-LD).
const faqEntries: FaqEntry[] = [
  {
    question: "Что такое семейный архив рода Логвиновых?",
    answer:
      "Это частный генеалогический проект: древо, хронология и галерея одной ветви рода Логвиновых. Архив создают родственники для родственников — он объединяет имена, даты, фотографии и семейные истории в одном месте."
  },
  {
    question: "Откуда произошла фамилия Логвинов?",
    answer:
      "Фамилия Логвинов образована от личного имени Логвин (церковная форма — Логгин). Такое происхождение приводят словари русских фамилий. Фамилия встречается у разных семей, которые чаще всего не состоят в родстве между собой, — поэтому совпадение фамилии само по себе о родстве не говорит."
  },
  {
    question: "Какие сведения в архиве открыты, а какие — только для семьи?",
    answer:
      "В публичной версии видны имена, годы жизни и общие материалы архива. Подробные карточки живых родственников открываются только после ввода семейного пароля."
  },
  {
    question: "Моя фамилия Логвинов или Логвинова — как узнать, наши это ветви?",
    answer:
      "Напишите хранителю архива на logvinovaleksander@gmail.com: расскажите об известных вам старших поколениях семьи, и мы сверим их с данными древа."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  themeColor="#182b3a"
  current=""
  bodyClass="landing-page"
  jsonLdNodes={[
    webPageNode("AboutPage", canonical.href, pageTitle, pageDescription),
    sectionsItemListNode(site),
    faqNode(canonical.href, faqEntries)
  ]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-map" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow eyebrow-light" id="hero-eyebrow">Семейный архив</p>
      <h1 id="hero-title">Род Логвиновых</h1>
      <p class="hero-subtitle">История семьи. Поколения. Память.</p>
      <p class="hero-description">Сохраняем лица, имена и истории, чтобы семейная память оставалась живой для тех, кто придёт после нас.</p>
      <div class="hero-actions">
        <button class="button button-primary button-large" type="button" data-open-login>🔒 Открыть полное древо</button>
        <a class="button button-ghost button-large" href={pageUrl("tree")}>Познакомиться с архивом</a>
      </div>
    </div>
    <div class="hero-meta" id="hero-meta" aria-label="Содержание семейного архива" hidden>
      <span>Загружаем данные архива…</span>
    </div>
  </section>

  <section class="on-this-day-section section-shell" id="on-this-day" aria-label="Памятные даты рода" hidden></section>

  <section class="intro section-shell" aria-labelledby="intro-title">
    <div>
      <p class="eyebrow">Живая память</p>
      <h2 id="intro-title">У каждой семьи есть история, которую важно услышать</h2>
    </div>
    <div class="intro-copy">
      <p>Этот проект объединяет семейные фотографии, документы и воспоминания в одном спокойном и понятном пространстве. Здесь можно проследить связи поколений и увидеть личную историю рядом с событиями эпохи.</p>
      <p>Архив создаётся родственниками и для родственников. Каждая карточка — приглашение вспомнить, уточнить и дополнить рассказ о человеке, а не просто строка в генеалогической таблице.</p>
      <p>Архив продолжает пополняться: новые имена, события и истории появляются по мере того, как родственники собирают и разбирают семейные материалы.</p>
    </div>
  </section>

  <section class="landing-section" id="tree" aria-labelledby="tree-preview-title">
    <div class="section-shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Связи поколений</p>
          <h2 id="tree-preview-title">Семейное древо</h2>
        </div>
        <p>Исследуйте ветви рода, меняйте масштаб и открывайте истории людей одним нажатием.</p>
      </div>
      <div class="tree-preview" id="tree-preview" aria-label="Схема поколений семьи">
        <p class="preview-hint">Загружаем поколения…</p>
      </div>
      <div class="section-action">
        <a class="button button-primary" href={pageUrl("tree")}>Исследовать древо <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="landing-section section-tinted" id="timeline" aria-labelledby="timeline-preview-title">
    <div class="section-shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Семья и время</p>
          <h2 id="timeline-preview-title">Хронология</h2>
        </div>
        <p>Рождения, браки и переезды — в контексте событий, которые меняли жизнь всей страны.</p>
      </div>
      <div class="timeline-preview" id="timeline-preview">
        <p class="preview-hint">Загружаем события…</p>
      </div>
      <div class="section-action">
        <a class="button button-secondary" href={pageUrl("timeline")}>Открыть всю хронологию <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="landing-section" id="gallery" aria-labelledby="gallery-preview-title">
    <div class="section-shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Фотографии и документы</p>
          <h2 id="gallery-preview-title">Семейная галерея</h2>
        </div>
        <p>Лица, письма и места, через которые прошлое становится ближе и понятнее.</p>
      </div>
      <div class="gallery-preview" id="gallery-preview">
        <p class="preview-hint">Загружаем материалы…</p>
      </div>
      <div class="section-action">
        <a class="button button-primary" href={pageUrl("gallery")}>Перейти в галерею <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="landing-section section-tinted" id="surname" aria-labelledby="surname-title">
    <div class="section-shell surname-grid">
      <div>
        <p class="eyebrow">Фамилия и род</p>
        <h2 id="surname-title">О фамилии Логвинов и об этом архиве</h2>
      </div>
      <div class="surname-copy">
        <p>Фамилия Логвинов образована от личного имени Логвин (церковная форма — Логгин). Такую родословную фамилию носят разные, не связанные между собой семьи — поэтому совпадение фамилии само по себе о родстве не говорит.</p>
        <p>Этот сайт — частная родословная одной конкретной ветви Логвиновых. Здесь собраны поколения семьи: имена и даты в генеалогическом древе, события в хронологии, фотографии и документы в галерее. Архив пополняется по мере того, как родственники разбирают семейные материалы.</p>
        <p>Если вас зовут Логвинов или Логвинова и вы ищете свои корни, — возможно, мы родственники. Напишите хранителю архива: вместе восстанавливать общую родословную проще.</p>
      </div>
    </div>
    <div class="section-shell">
      <div class="faq-list" id="faq">
        {faqEntries.map(({ question, answer }) => (
          <details class="faq-item">
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="section-shell about-grid">
      <div>
        <p class="eyebrow eyebrow-light">О проекте</p>
        <h2 id="about-title">Архив, который мы создаём вместе</h2>
      </div>
      <div>
        <p>Цель проекта — не только восстановить родословную, но и сохранить характеры, голоса и повседневные истории семьи. Мы бережно относимся к личным данным: подробные сведения о живых родственниках доступны только в семейном режиме.</p>
        <p>Если у вас есть фотографии, документы или воспоминания, вы можете дополнить архив. Для участия напишите хранителю проекта и укажите, к какой ветви семьи относятся материалы.</p>
        <a class="text-link text-link-light" href="mailto:logvinovaleksander@gmail.com?subject=Участие%20в%20семейном%20архиве">Присоединиться к проекту: logvinovaleksander@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <noscript><p class="noscript-note">Превью разделов на главной заполняются из семейного архива — включите JavaScript.</p></noscript>
</BaseLayout>

<script src="../components/landing/landing-controller.ts"></script>
