---
import BaseLayout from "../layouts/BaseLayout.astro";
import AsyncState from "../components/AsyncState.astro";
import Timeline from "../components/timeline/Timeline.astro";
import "../styles/features/timeline.css";
import { canonicalUrlOf, webPageNode } from "../lib/seo";

const pageTitle = "Хронология рода Логвиновых — Род Логвиновых";
const pageDescription =
  "Хронология семьи Логвиновых: рождения, браки и переезды поколений рода — в контексте исторических событий, которые меняли жизнь страны.";
const canonical = canonicalUrlOf(Astro.url.pathname, Astro.site ?? new URL("https://logvinov-tree.ru"));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  current="timeline"
  jsonLdNodes={[webPageNode("WebPage", canonical.href, pageTitle, pageDescription)]}
>
  <section class="page-intro section-shell">
    <p class="eyebrow">Семья и время</p>
    <h1>Хронология рода</h1>
    <p>Личные события не существуют отдельно от эпохи. На одной линии времени мы соединяем семейные даты и исторические вехи.</p>
    <div class="timeline-key">
      <span><i class="key-dot family"></i>Семейные события</span>
      <span><i class="key-dot history"></i>Исторический контекст</span>
      <span class="key-vital"><b aria-hidden="true">*</b> рождение · <b aria-hidden="true">†</b> смерть — даты рода</span>
    </div>
  </section>
  <section class="timeline-section section-shell" aria-label="События семейной истории">
    <AsyncState idPrefix="timeline" errorTitle="Не удалось загрузить хронологию">
      <Timeline />
    </AsyncState>
    <noscript><p class="noscript-note">Для отображения хронологии необходимо включить JavaScript.</p></noscript>
  </section>
  <script src="../components/timeline/timeline-controller.ts"></script>
</BaseLayout>
