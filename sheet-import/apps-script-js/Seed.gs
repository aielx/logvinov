const SHEET_FOR_DEMO = {
  [SHEETS.PEOPLE]: "people",
  [SHEETS.EVENTS]: "events",
  [SHEETS.MATERIALS]: "materials"
};
function seedDemoData() {
  const spreadsheet = getSpreadsheet();
  Object.entries(SHEET_FOR_DEMO).forEach(([sheetName, demoKey]) => {
    const sheet = spreadsheet.getSheetByName(sheetName);
    if (!sheet) return;
    const rows = DEMO[demoKey];
    if (sheet.getLastRow() > 1 || rows.length === 0) return;
    sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);
  });
}

