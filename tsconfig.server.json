{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["google-apps-script", "vitest/globals", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "apps-script/src/**/*",
    "apps-script/tests/**/*",
    "tests/unit/server/**/*",
    "scripts/generate-mock-data.ts",
    "vitest.server.config.ts"
  ]
}
